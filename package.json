{
  "name": "continuity-local",
  "version": "2.0.0-beta.15",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.4 <27"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.tui.json --noEmit && vite build",
    "start": "tsx src/server/main.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "doctor": "tsx src/cli/main.ts doctor",
    "continuity": "tsx src/cli/main.ts",
    "context:update": "node scripts/context.mjs",
    "rilascio": "node scripts/rilascio.mjs",
    "context:watch": "node scripts/context.mjs --watch",
    "prebuild": "node scripts/context.mjs"
  },
  "dependencies": {
    "tsx": "^4.20.5",
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@fastify/static": "^8.2.0",
    "@opentui/core": "0.6.4",
    "@opentui/solid": "0.6.4",
    "babel-plugin-module-resolver": "5.0.2",
    "babel-preset-solid": "1.9.12",
    "fastify": "^5.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "solid-js": "1.9.12",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prettier": "3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
